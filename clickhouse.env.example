# Copy to clickhouse.env and fill in real values. clickhouse.env is gitignored.
#
# Local Docker (docker-compose.yml in this repo):
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
# Optional database namespace; useful for isolated development/test data.
CLICKHOUSE_DATABASE=default
#
# ClickHouse Cloud (each teammate points at the same service with their own
# credentials): set CLICKHOUSE_SECURE=1, the HTTPS port, and the cloud host/user.
# CLICKHOUSE_HOST=<your-instance>.<region>.clickhouse.cloud
# CLICKHOUSE_PORT=8443
# CLICKHOUSE_SECURE=1
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=<your password>

# URLhaus now requires authentication (mandatory since 2025-06-30).
# Request a free Auth-Key at https://auth.abuse.ch/ then paste it below.
URLHAUS_AUTH_KEY=
