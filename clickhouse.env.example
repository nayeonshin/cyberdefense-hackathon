# Copy to clickhouse.env and fill in real values. clickhouse.env is gitignored.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# URLhaus now requires authentication (mandatory since 2025-06-30).
# Request a free Auth-Key at https://auth.abuse.ch/ then paste it below.
URLHAUS_AUTH_KEY=
