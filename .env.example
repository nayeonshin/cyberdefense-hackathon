# Copy to .env and fill in. Never commit .env.

# ClickHouse Cloud (Connect dialog in the console)
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# Public feed repo: local clone path and where it is served
FEED_REPO_DIR=../threat-feed
FEED_PUBLIC_URL=

# Reporting channels
URLSCAN_API_KEY=
ABUSEIPDB_API_KEY=
NETCRAFT_REPORT_URL=https://report.netcraft.com/api/v3/report/urls
REPORTER_EMAIL=
REPORTER_ORG=Takedown Orchestrator (hackathon research project)

# Mail sink (Mailpit: docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025

# Controlled target for the on-stage loop
MOCK_REGISTRAR_URL=http://localhost:8099

# Live switches. Nothing leaves the machine unless --live is passed AND the channel is 1.
LIVE_FEED=0
LIVE_URLSCAN=0
LIVE_NETCRAFT=0
LIVE_ABUSEIPDB=0
LIVE_EMAIL=0

# Member 4. Default mode is a clearly labeled, non-dispatching UI preview.
DATA_SOURCE=fixtures
RUN_MODE=preview
RUN_ID=development
DATA_DIR=.runtime
CLICKHOUSE_SECURE=1
EVENTS_TABLE=incoming_threats
CONTROLLED_TARGET_URL=http://localhost:8099/site
POLL_SECONDS=2
RECHECK_SECONDS=5

# Long-running teammate commands as JSON argv arrays (no shell interpretation).
# Add pinned dependencies to requirements-team.txt before building the image.
INGEST_COMMAND_JSON=
SCAN_COMMAND_JSON=

# Actor
AKASHML_API_KEY=
AKASHML_BASE_URL=
AKASHML_MODEL=
CONTROLLED_HOSTS=
HISTORY_LOOKUP=0
